# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries variable names and no values. It was
# swallowed by the pattern above, which is a large part of why nobody knew the
# ADMIN_* variables existed and the panel ran on its source-code defaults.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Niscala: raw source material (342 MB, source of /public/images) - never deployed
/BAHAN


# Optimised output in /public IS committed on purpose: it is the only
# copy that ships, since /BAHAN never leaves this machine.

# Niscala: SEO audit scratch output (reports + a throwaway Chrome profile).
# Not gitignoring this also makes Tailwind scan the locked profile files and
# crash `next build` on Windows.
/.seo-audit
