# =====================================================================
# NISCALA FURNITURE - environment
# Copy to .env.local and fill in the real values.
# Every value below is currently a PLACEHOLDER.
# =====================================================================

# Canonical site origin, no trailing slash. Used for metadata + sitemap.
NEXT_PUBLIC_SITE_URL=https://niscalafurniture.com

# Business WhatsApp, international format WITHOUT "+" or spaces.
# Example for Indonesia: 6281234567890
NEXT_PUBLIC_WHATSAPP_NUMBER=6281772332300

# Public contact email shown in the footer and contact page.
NEXT_PUBLIC_CONTACT_EMAIL=info@niscalafurniture.com

# Social profiles. Leave blank to hide the link entirely.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_THREADS_URL=

# Year the studio was founded. Leave blank to hide every "established" claim.
NEXT_PUBLIC_FOUNDED_YEAR=

# ---------------------------------------------------------------------
# Local SEO. Every field below is OPTIONAL and starts empty on purpose:
# LocalBusiness structured data emits a property only once its value is
# filled in here, so a half-configured deployment never publishes an
# address, coordinate or price the studio has not confirmed.
# Filling these in is the single biggest remaining local-search win.
# ---------------------------------------------------------------------

# Claimed Google Business Profile / Maps listing. Published as sameAs+hasMap.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Public workshop or showroom address. Leave ALL blank to publish no address.
NEXT_PUBLIC_STREET_ADDRESS=
NEXT_PUBLIC_ADDRESS_LOCALITY=
NEXT_PUBLIC_ADDRESS_REGION=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=

# Coordinates of that address. Published only as a matched pair.
NEXT_PUBLIC_LATITUDE=
NEXT_PUBLIC_LONGITUDE=

# Fixed operating hours. Days in English, as schema.org expects.
# Example: Monday,Tuesday,Wednesday,Thursday,Friday,Saturday
NEXT_PUBLIC_OPENING_DAYS=
NEXT_PUBLIC_OPENING_TIME=
NEXT_PUBLIC_CLOSING_TIME=

# Price band shown in search results, e.g. "Rp5.000.000 - Rp150.000.000".
# Leave blank until the studio approves a range it will actually honour.
NEXT_PUBLIC_PRICE_RANGE=

# Set to "true" ONLY once real testimonials replace the placeholder data in
# src/data/testimonials.ts. While false, the testimonial section is hidden in
# production so dummy quotes are never published as if they were real.
NEXT_PUBLIC_SHOW_TESTIMONIALS=false

# Server-only. Optional webhook that receives validated survey leads
# (e.g. a Zapier / Make / n8n / Google Apps Script endpoint).
# Leave blank: the form still works and hands the lead over to WhatsApp.
LEAD_WEBHOOK_URL=

# --- Admin panel ------------------------------------------------------------
# All three are required. There are no defaults: if any is missing the admin
# panel refuses every login and says so in the server log. The rest of the site
# is unaffected, so a missing value disables the panel rather than the build.
#
#   npm run admin:secret     generates ADMIN_SECRET
#   npm run admin:password   generates ADMIN_PASSWORD_HASH
#
# ADMIN_SECRET signs the session cookie and must be its own random value, never
# derived from the password. Changing it signs out every existing session,
# which is the only way to revoke one.
ADMIN_USERNAME=
ADMIN_SECRET=
ADMIN_PASSWORD_HASH=
# Plaintext alternative to ADMIN_PASSWORD_HASH. Accepted, but the hash is
# preferred: it is what protects the password if the environment ever leaks.
# ADMIN_PASSWORD=
